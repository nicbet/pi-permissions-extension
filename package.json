{
  "name": "@nicbet/pi-permissions-extension",
  "version": "0.1.4",
  "description": "Require confirmation before Pi runs dangerous bash commands",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicbet/pi-permissions-extension.git"
  },
  "bugs": {
    "url": "https://github.com/nicbet/pi-permissions-extension/issues"
  },
  "homepage": "https://github.com/nicbet/pi-permissions-extension#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "biome lint index.ts index.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "permissions",
    "security"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.2.0",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
